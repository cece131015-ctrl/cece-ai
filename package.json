{
  "name": "cece-ai",
  "private": true,
  "description": "Cece AI: un solo archivo HTML. El programa se edita en fuente/ y se empaqueta en cece-ai.html.",
  "scripts": {
    "desempaquetar": "node herramientas/desempaquetar.js",
    "empaquetar": "node herramientas/empaquetar.js",
    "lint": "eslint fuente/programa.js && ruff check fuente/cecehub-server.py",
    "probar": "node herramientas/probar.js",
    "probar:rea-servidor": "node herramientas/probar-rea-servidor.js",
    "test": "npm run probar && npm run probar:rea-servidor",
    "start": "node integraciones/rea/servidor.mjs"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0",
    "terser": "^5.0.0",
    "playwright": "^1.55.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
